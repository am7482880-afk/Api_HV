                "registro-usuario"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Muñoz\",\n  \"correo\": \"ana@gmail.com\",\n  \"password\": \"Clave12345\"\n}",
