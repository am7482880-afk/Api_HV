# Copia este archivo como .env y cambia los valores si hace falta

# Clave para firmar los tokens JWT (larga, mínimo 32 caracteres, no la compartas)
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta-2026-hojavida
# Duración del token en horas
JWT_HORAS=8

# MySQL de XAMPP (por defecto: usuario root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hojavida_nana

# Direcciones desde donde React puede llamar a la API
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
